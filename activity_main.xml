<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/ink_black"
    android:padding="12dp">

    <!-- Header -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="⚓ EDITH"
        android:textColor="@color/treasure_gold"
        android:textSize="28sp"
        android:textStyle="bold"
        android:gravity="center"
        android:paddingBottom="4dp" />

    <TextView
        android:id="@+id/statusText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/comic_white"
        android:textSize="12sp"
        android:gravity="center"
        android:paddingBottom="8dp" />

    <!-- Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingBottom="8dp">

        <Button
            android:id="@+id/startServiceBtn"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Start Brain"
            android:textColor="@color/ink_black"
            android:backgroundTint="@color/treasure_gold"
            android:layout_marginEnd="4dp" />

        <Button
            android:id="@+id/accessibilityBtn"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Unlock Power"
            android:textColor="@color/white"
            android:backgroundTint="@color/pirate_red"
            android:layout_marginStart="4dp" />
    </LinearLayout>

    <!-- Chat -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/chatRecycler"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="8dp" />

    <!-- Input -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@color/deep_ocean"
        android:padding="8dp">

        <EditText
            android:id="@+id/inputField"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="Command me..."
            android:textColor="@color/comic_white"
            android:textColorHint="#88FFFFFF"
            android:background="@android:color/transparent"
            android:padding="12dp"
            android:imeOptions="actionSend"
            android:inputType="text" />

        <Button
            android:id="@+id/sendButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SEND"
            android:textColor="@color/ink_black"
            android:backgroundTint="@color/sunny_orange" />
    </LinearLayout>
</LinearLayout>
